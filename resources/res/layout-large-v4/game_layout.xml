<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/list_selector"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/top_box"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/league_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/game_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginLeft="6dp"
                android:contentDescription="League Icon"/>
            <com.thuuz.roboto.RobotoTextView
                android:textSize="14sp"
                android:textColor="@color/game_header_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                custom:typeface="4"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clock_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/tv_icon"
                android:background="@drawable/tv_indicator_large"
                android:visibility="gone"
                android:layout_width="13dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                android:contentDescription="TV Icon"/>
            <com.thuuz.roboto.RobotoTextView
                android:textSize="14sp"
                android:textColor="@color/game_header_text"
                android:layout_gravity="center"
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:minWidth="35dp"
                android:singleLine="true"
                custom:typeface="4"/>
        </LinearLayout>
        <com.thuuz.roboto.RobotoTextView
            android:textSize="14sp"
            android:textColor="@color/game_header_text"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/clock_lay"
            android:layout_toRightOf="@+id/league_info"
            android:layout_centerVertical="true"
            custom:typeface="4"/>
    </RelativeLayout>
    <View
        android:id="@+id/top_divider"
        android:background="@color/guide_bg_barely_trans"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/game_rlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="204dp">
        <RelativeLayout
            android:id="@+id/score_thumb_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_alignParentTop="true">
            <com.thuuz.gtv.view.GecCircleView
                android:textSize="@dimen/gec_bubble_size"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/game_gec"
                android:visibility="gone"
                android:layout_width="@dimen/gec_circle_side"
                android:layout_height="@dimen/gec_circle_side"
                android:layout_marginLeft="10dp"
                android:layout_centerVertical="true"
                custom:typeface="6"/>
            <com.thuuz.gtv.view.PlayThumbnail
                android:id="@+id/highlight_layout"
                android:background="@drawable/default_video"
                android:visibility="gone"
                android:layout_width="@dimen/highlight_thumb_width"
                android:layout_height="@dimen/highlight_thumb_height"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:scaleType="fitXY"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <TableLayout
                android:id="@+id/text_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:stretchColumns="1"
                android:shrinkColumns="1"
                android:layout_toLeftOf="@+id/highlight_layout"
                android:layout_toRightOf="@+id/game_gec"
                android:layout_centerVertical="true">
                <LinearLayout
                    android:id="@+id/tourney_row"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:id="@+id/tourney"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        style="@style/GameTeamName"/>
                </LinearLayout>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="28dp">
                    <com.thuuz.gtv.widget.NetworkListenableImageView
                        android:id="@+id/team_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginRight="8dp"
                        android:maxWidth="28dp"
                        android:maxHeight="28dp"
                        android:contentDescription="Team Icon"/>
                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.thuuz.roboto.RobotoTextView
                            android:textSize="@dimen/team_name_size"
                            android:textColor="@color/winning_team_text"
                            android:ellipsize="end"
                            android:id="@+id/team_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:drawablePadding="5dp"
                            android:layout_centerVertical="true"
                            custom:typeface="4"
                            style="@style/GameTeamName"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:gravity="right"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/score_lay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp">
                        <com.thuuz.roboto.RobotoTextView
                            android:textSize="@dimen/team_name_size"
                            android:textStyle="bold"
                            android:textColor="@color/white_f8"
                            android:id="@+id/score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_centerVertical="true"
                            custom:typeface="4"/>
                    </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp">
                    <com.thuuz.gtv.widget.NetworkListenableImageView
                        android:id="@+id/team_icon2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="8dp"
                        android:maxWidth="28dp"
                        android:maxHeight="28dp"
                        android:contentDescription="Team Icon"/>
                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.thuuz.roboto.RobotoTextView
                            android:textSize="@dimen/team_name_size"
                            android:textColor="@color/winning_team_text"
                            android:ellipsize="end"
                            android:id="@+id/team2_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:drawablePadding="5dp"
                            android:layout_centerVertical="true"
                            custom:typeface="4"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:gravity="right"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/score2_lay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp">
                        <com.thuuz.roboto.RobotoTextView
                            android:textSize="@dimen/team_name_size"
                            android:textColor="@color/white_f1"
                            android:id="@+id/score2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_centerVertical="true"
                            custom:typeface="4"/>
                    </RelativeLayout>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/teaser_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_marginRight="6dp"
                        android:layout_span="3">
                        <com.thuuz.roboto.RobotoTextView
                            android:textSize="@dimen/teaser_size"
                            android:textColor="@color/teaser_text"
                            android:ellipsize="end"
                            android:gravity="top"
                            android:layout_gravity="top"
                            android:id="@+id/teaser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            custom:typeface="4"/>
                    </RelativeLayout>
                </TableRow>
            </TableLayout>
        </RelativeLayout>
    </RelativeLayout>
    <com.thuuz.gtv.widget.NetworkListenableImageView
        android:id="@+id/gec_plot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_cell_1d_plot_height"
        android:layout_marginTop="5dp"
        android:scaleType="fitXY"
        android:contentDescription="Game Excitement Plot"/>
</LinearLayout>
