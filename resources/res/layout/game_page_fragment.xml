<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/game_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/game_page_margin"
        android:baselineAligned="false">
        <RelativeLayout
            android:id="@+id/game_left_side_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@integer/left_side_percent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/left_side_vert_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/game_layout"
                    android:layout_height="wrap_content"
                    layout="@layout/game_layout"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/guide_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/game_page_margin">
                    <include
                        android:id="@+id/track_fragment"
                        android:background="@color/game_cell_bg"
                        layout="@layout/game_page_tv_frag"/>
                    <View
                        android:background="@color/guide_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/game_page_margin"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
