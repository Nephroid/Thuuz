<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/checkin_bg"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"/>
        <com.thuuz.gtv.view.MultilineDoneEditText
            android:textColorHint="@color/black"
            android:gravity="top"
            android:layout_gravity="center_horizontal"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:hint="@string/share_hint"
            android:lines="2"
            android:singleLine="false"
            android:maxLength="256"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"/>
        <Spinner
            android:id="@+id/tag_a_rival"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:maxHeight="46dp"
            android:minHeight="44dp"/>
        <View
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="-7dp"
            android:layout_marginRight="14dp"/>
        <TextView
            android:textSize="12sp"
            android:ellipsize="middle"
            android:id="@+id/url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="6dp"
            android:text=""
            android:singleLine="true"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp">
            <CheckBox
                android:id="@+id/post_to_twitter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:button="@drawable/checkbox_tweeter"
                android:layout_centerVertical="true"/>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fake_disabled_button_text_color"
                android:id="@+id/share_other"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share to other apps"
                android:drawableLeft="@drawable/share_button_icon"
                android:drawablePadding="10dp"
                android:layout_alignParentRight="true"
                style="@style/FakeDisabledBlueButton"/>
            <Button
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/share_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:text="Check In"
                android:layout_toRightOf="@+id/post_to_twitter"
                style="@style/BlueButton"/>
        </RelativeLayout>
        <CheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/alert_my_friends"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Also send\10Thuuz alert"
            android:lines="2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/white_f1"
                android:gravity="left"
                android:layout_gravity="center"
                android:id="@+id/game_title"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="diamondbacks vs. diamondbacks"
                android:layout_weight="1"
                style="@style/text_18_f1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
