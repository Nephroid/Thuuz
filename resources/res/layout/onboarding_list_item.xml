<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/list_selector"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/separator"
        android:background="@color/guide_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        style="@style/ListSeparator">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:id="@+id/separatorTitle"
            android:background="@color/guide_bg"
            android:paddingLeft="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="title"
            style="@style/ListSeparatorTitle"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/selectable_item"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:minHeight="55dp"
        android:layout_below="@+id/separator">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/check_box"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/icon_container"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            style="@style/text_18_bold_f1"/>
        <TextView
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_toLeftOf="@+id/icon_container"
            android:layout_below="@+id/title"
            android:layout_alignParentLeft="true"
            style="@style/text_14_normal_f1"/>
    </RelativeLayout>
</RelativeLayout>
