<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <RelativeLayout
            android:id="@+id/left_side_layout"
            android:padding="@dimen/game_page_margin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/left_side_percent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/first_lay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:gravity="right"
                            android:layout_gravity="center"
                            android:id="@+id/first_label"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="First name: "
                            style="@style/text_16_bold_f1"/>
                        <EditText
                            android:id="@+id/first"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textPersonName">
                            <requestFocus/>
                        </EditText>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/last_lay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:layout_below="@+id/first_lay">
                        <TextView
                            android:gravity="right"
                            android:layout_gravity="center"
                            android:id="@+id/last_label"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Last name: "
                            style="@style/text_16_bold_f1"/>
                        <EditText
                            android:id="@+id/lastname"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textPersonName"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/user_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:layout_below="@+id/last_lay">
                        <TextView
                            android:gravity="right"
                            android:layout_gravity="center"
                            android:id="@+id/user_label"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Email: "
                            style="@style/text_16_bold_f1"/>
                        <EditText
                            android:id="@+id/email"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textEmailAddress"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/pwd_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:layout_below="@+id/user_layout">
                        <TextView
                            android:gravity="right"
                            android:layout_gravity="center"
                            android:id="@+id/pass_label"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Password: "
                            style="@style/text_16_bold_f1"/>
                        <EditText
                            android:id="@+id/pass"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textVisiblePassword"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/register_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="19dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="19dp"
                        android:text="Register"
                        android:layout_below="@+id/pwd_layout"/>
                </RelativeLayout>
            </ScrollView>
        </RelativeLayout>
        <include
            android:id="@+id/right_side_layout"
            layout="@layout/right_side_frame"/>
    </LinearLayout>
    <include layout="@layout/sliding_menu"/>
</android.support.v4.widget.DrawerLayout>
