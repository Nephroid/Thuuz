<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <RelativeLayout
            android:id="@+id/left_side_layout"
            android:padding="@dimen/game_page_margin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/left_side_percent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white_f1"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/no_teams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="You haven&apos;t imported any fantasy teams yet.\10What are you waiting for?"
                    android:lines="2"/>
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/import_teams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Import more teams">
                    <requestFocus/>
                </Button>
                <com.thuuz.gtv.util.ProtectedListView
                    android:id="@+id/list"
                    android:descendantFocusability="afterDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="@null"
                    style="@style/ListViewWithHeader"/>
            </LinearLayout>
        </RelativeLayout>
        <include
            android:id="@+id/right_side_layout"
            layout="@layout/right_side_frame"/>
    </LinearLayout>
    <include layout="@layout/sliding_menu"/>
</android.support.v4.widget.DrawerLayout>
