<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_layout"
        android:background="@drawable/list_selector"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_centerVertical="true">
        <LinearLayout
            android:id="@+id/disclosure_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white_ff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/live_count"
                android:background="@color/badge_bg"
                android:paddingLeft="6dp"
                android:paddingTop="5dp"
                android:paddingRight="6dp"
                android:paddingBottom="5dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"/>
            <ImageView
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/disclosure_image"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:src="@drawable/disclosure"
                android:minWidth="17dp"
                android:contentDescription="expand disclosure"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="32dp"
                android:contentDescription="expand"/>
        </LinearLayout>
        <com.thuuz.roboto.RobotoTextView
            android:textSize="20dp"
            android:textColor="@color/white_ff"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:singleLine="false"
            android:layout_toLeftOf="@+id/disclosure_wrap"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true"
            custom:typeface="serif"/>
    </RelativeLayout>
</RelativeLayout>
