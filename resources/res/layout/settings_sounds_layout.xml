<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <RelativeLayout
            android:id="@+id/left_side_layout"
            android:padding="@dimen/game_page_margin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/left_side_percent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp">
                    <Button
                        android:id="@+id/change_sound_and_vibration_settings_button"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:text="Change Sound and Vibration Settings"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/sound_and_vibration_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/sound_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="Select Sound:"
                            style="@style/text_16_bold_f1"/>
                        <com.thuuz.gtv.view.FakeSpinDropView
                            android:id="@+id/select_sound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:minHeight="48dp"/>
                        <TextView
                            android:id="@+id/vib_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="@string/select_vib"
                            style="@style/text_16_bold_f1"/>
                        <Spinner
                            android:id="@+id/select_vib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:minHeight="48dp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="Select Duration of On-screen Alert Text:"
                        style="@style/text_16_bold_f1"/>
                    <Spinner
                        android:id="@+id/select_toast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"/>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
        <include
            android:id="@+id/right_side_layout"
            layout="@layout/right_side_frame"/>
    </LinearLayout>
    <include layout="@layout/sliding_menu"/>
</android.support.v4.widget.DrawerLayout>
