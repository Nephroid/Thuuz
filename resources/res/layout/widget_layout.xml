<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lay"
    android:background="@color/dark_2_gray"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="40dp">
    <RelativeLayout
        android:id="@+id/controls"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageButton
            android:id="@+id/thuuz_logo"
            android:background="@drawable/list_black_selector"
            android:layout_width="85dp"
            android:layout_height="36dp"
            android:layout_marginLeft="-3dp"
            android:layout_marginRight="-3dp"
            android:src="@drawable/logo"
            android:layout_centerVertical="true"
            android:contentDescription="logo"/>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/button_lay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageButton
                android:id="@+id/refresh"
                android:background="@drawable/list_black_selector"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_action_refresh"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:contentDescription="refresh"/>
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/progress"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="5dp"
                android:indeterminate="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/button_lay"
            android:layout_toRightOf="@+id/thuuz_logo"
            android:layout_centerInParent="true">
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/ColumnHeaderText"/>
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/fetch_date"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
    <ListView
        android:id="@+id/widget_list"
        android:background="@color/game_cell_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@color/black"
        android:dividerHeight="3dp"
        android:minWidth="104dp"
        android:minHeight="40dp"
        android:layout_below="@+id/controls"/>
    <TextView
        android:gravity="center"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No games. Add more favorites via Thuuz."
        android:layout_centerInParent="true"
        style="@style/ColumnHeaderText"/>
</RelativeLayout>
