<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/game_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <include
            android:id="@+id/game_layout"
            layout="@layout/game_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <ScrollView
                android:id="@+id/mid_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/game_page_margin"
                android:layout_weight="@integer/right_side_percent"
                android:overScrollMode="never">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/watch_lay"
                        android:background="@color/game_midbar_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/game_page_margin"/>
                    <FrameLayout
                        android:id="@+id/highlight_lay"
                        android:background="@color/game_midbar_bg"
                        android:nextFocusUp="@+id/watch_lay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/game_page_margin"/>
                    <FrameLayout
                        android:id="@+id/friends_lay"
                        android:background="@color/game_midbar_bg"
                        android:nextFocusUp="@+id/highlight_lay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="2dp"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
