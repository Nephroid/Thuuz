<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/webview_fragment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp">
    <Button
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white_f1"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/spoilers_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Show Spoilers"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/webview_loading_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ProgressBar
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/Widget.ProgressBar.Small"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/loading_msg"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Loading..."
            style="@style/text_16_bold_f1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/focus_rect_lay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.thuuz.gtv.view.FocusingWebView
            android:id="@+id/webview"
            android:background="#00000000"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
