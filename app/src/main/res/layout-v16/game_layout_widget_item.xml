<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="100dp"
    android:minHeight="40dp">
    <RelativeLayout
        android:id="@+id/top_box"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/league_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/game_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginLeft="6dp"
                android:contentDescription="League Icon"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/game_header_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clock_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/tv_icon"
                android:background="@drawable/tv_indicator_large"
                android:visibility="gone"
                android:layout_width="13dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                android:contentDescription="TV Icon"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/game_header_text"
                android:layout_gravity="center"
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:minWidth="35dp"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/game_header_text"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/clock_lay"
            android:layout_toRightOf="@+id/league_info"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/top_divider"
        android:background="@color/guide_bg_barely_trans"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/game_rlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="104dp">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/gec_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_centerVertical="true">
            <ImageView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/gec_img"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:minWidth="35dp"
                android:contentDescription="rating"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/gec_text"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:minWidth="35dp"
                android:text="39"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/text_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="10dp"
            android:layout_toRightOf="@+id/gec_lay"
            android:layout_centerVertical="true">
            <LinearLayout
                android:id="@+id/tourney_row"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">
                <TextView
                    android:id="@+id/tourney"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="false"
                    style="@style/GameTeamName"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/teams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/fan_icon"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/fan_icon_r_margin"
                    android:src="@drawable/tiny_fan_gray"
                    android:layout_centerVertical="true"
                    android:contentDescription="Fan Finger"/>
                <RelativeLayout
                    android:gravity="right"
                    android:id="@+id/score_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_alignParentRight="true">
                    <TextView
                        android:textSize="@dimen/team_name_size"
                        android:textColor="@color/white_f8"
                        android:id="@+id/score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="monospace"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/team_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/score_lay"
                    android:layout_toRightOf="@+id/fan_icon">
                    <TextView
                        android:textSize="@dimen/team_name_size"
                        android:textColor="@color/winning_team_text"
                        android:ellipsize="end"
                        android:id="@+id/team_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:drawablePadding="5dp"
                        android:layout_centerVertical="true"
                        style="@style/GameTeamName"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/fan_icon2"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/fan_icon_r_margin"
                    android:src="@drawable/tiny_fan_gray"
                    android:layout_centerVertical="true"
                    android:contentDescription="Fan Finger"/>
                <RelativeLayout
                    android:gravity="right"
                    android:id="@+id/score2_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_alignParentRight="true">
                    <TextView
                        android:textSize="@dimen/team_name_size"
                        android:textColor="@color/white_f1"
                        android:id="@+id/score2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="monospace"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/team2_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/score2_lay"
                    android:layout_toRightOf="@+id/fan_icon2">
                    <TextView
                        android:textSize="@dimen/team_name_size"
                        android:textColor="@color/winning_team_text"
                        android:ellipsize="end"
                        android:id="@+id/team2_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:drawablePadding="5dp"
                        android:layout_centerVertical="true"
                        style="@style/GameTeamName"/>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/fan_icon3"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/fan_icon_r_margin"
                    android:src="@drawable/tiny_fan_gray"
                    android:contentDescription="Fan Finger"/>
                <TextView
                    android:textSize="@dimen/teaser_size"
                    android:textColor="@color/teaser_text"
                    android:ellipsize="end"
                    android:layout_gravity="top"
                    android:id="@+id/teaser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
