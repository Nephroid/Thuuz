<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <RelativeLayout
        android:id="@+id/left_side_layout"
        android:padding="@dimen/game_page_margin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/left_side_percent">
        <FrameLayout
            android:id="@+id/left_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/right_side_layout"
        android:background="@color/sidebar_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/right_side_percent"/>
</LinearLayout>
