<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/column_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/pers_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <include
                android:id="@+id/personalize_layout"
                layout="@layout/pers_layout"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/banner"
            android:background="@drawable/button_image_selector"
            android:padding="@dimen/banner_padding"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:adjustViewBounds="true"
            android:maxHeight="75dp"
            android:minHeight="0dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="advertisement"/>
        <View
            android:gravity="top"
            android:background="@color/guide_bg"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_below="@+id/pers_wrap"/>
        <com.thuuz.gtv.view.HorizColumnScroll
            android:id="@+id/hscroll"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:focusable="true"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#000000"
            android:dividerHeight="2dp"
            android:fillViewport="true"
            android:layout_above="@+id/banner"
            android:layout_below="@+id/pers_wrap"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:id="@+id/none_found"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No games found. Please refresh later."
            android:layout_centerInParent="true"
            style="@style/ColumnHeaderText"/>
    </RelativeLayout>
    <include layout="@layout/sliding_menu"/>
</android.support.v4.widget.DrawerLayout>
