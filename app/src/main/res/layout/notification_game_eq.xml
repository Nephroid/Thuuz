<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/image_container"
        android:background="@drawable/selector_notif_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/thuuz_logo"
            android:layout_width="50dp"
            android:layout_height="17dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/thuuz_logo_gtv"
            android:minWidth="50dp"
            android:layout_centerVertical="true"
            android:contentDescription="logo"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/gec_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/gec_dull"
                android:background="@drawable/gray_dot_small"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:minWidth="35dp"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/gec_ok"
                android:background="@drawable/yellow_dot_small"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:minWidth="35dp"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/gec_good"
                android:background="@drawable/orange_dot_small"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:minWidth="35dp"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/gec_great"
                android:background="@drawable/red_dot_small"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:minWidth="35dp"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/line1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="2dp"
            android:maxLines="3"
            android:singleLine="false"
            android:layout_toLeftOf="@+id/gec_lay"
            android:layout_toRightOf="@+id/thuuz_logo"
            android:layout_centerVertical="true"
            style="@style/text_14_normal_f1"/>
    </RelativeLayout>
</RelativeLayout>
