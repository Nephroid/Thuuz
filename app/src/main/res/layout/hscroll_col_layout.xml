<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/header_words"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/live_indic_layout"
                android:background="@color/badge_bg"
                android:paddingLeft="1dp"
                android:paddingTop="2dp"
                android:paddingRight="1dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:text="0"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/live_count_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_centerInParent="true"
                    style="@style/FilterLiveIndicatorBg"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white_ff"
                    android:id="@+id/live_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <com.thuuz.roboto.RobotoTextView
                android:layout_gravity="center"
                android:id="@+id/list1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ColumnHeaderText"/>
        </LinearLayout>
        <com.thuuz.roboto.RobotoTextView
            android:id="@+id/left_arrow"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            style="@style/ColumnEarlierLaterText"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <com.thuuz.roboto.RobotoTextView
                android:id="@+id/right_arrow"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text=""
                style="@style/ColumnEarlierLaterText"/>
        </LinearLayout>
    </RelativeLayout>
    <com.thuuz.gtv.view.ListViewDpad
        android:layout_gravity="center_horizontal"
        android:id="@+id/earlier"
        android:background="@color/guide_bg"
        android:padding="0dp"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:listSelector="@null"
        android:cacheColorHint="@color/guide_bg"
        android:divider="@color/guide_bg"
        android:dividerHeight="8dp"
        android:choiceMode="singleChoice"
        android:overScrollFooter="@null"/>
    <View
        android:id="@+id/blackline"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
