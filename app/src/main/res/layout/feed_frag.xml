<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/top_line_separator"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:id="@+id/thuuz_it_hideshow_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/thuuz_it_container"
            android:background="@color/dark_gray"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="14sp"
                android:textStyle="bold"
                android:id="@+id/thuuz_edit"
                android:background="@drawable/fake_edit_text_selector"
                android:padding="6dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:hint=" Post your Thuuz"
                android:singleLine="true"
                android:drawableLeft="@drawable/add_comment"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@+id/line"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/thuuz_it_hideshow_lay"/>
    <WebView
        android:id="@+id/webview"
        android:background="#00000000"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/line"
        android:layout_below="@+id/top_line_separator">
        <requestFocus/>
    </WebView>
</RelativeLayout>
