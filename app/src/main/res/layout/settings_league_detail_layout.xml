<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <RelativeLayout
            android:id="@+id/left_side_layout"
            android:padding="@dimen/game_page_margin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/left_side_percent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="20sp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/alert_settings"
                    style="@style/text_18_bold_f1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp">
                    <CheckBox
                        android:id="@+id/gec_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="0dp"
                        android:layout_alignParentRight="true">
                        <requestFocus/>
                    </CheckBox>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/gec_toggle"
                        android:layout_alignParentLeft="true">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/white_f1"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/game_excitement_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Game Excitement"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray"
                            android:id="@+id/game_excitement_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Get alerted when any game gets exciting."/>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fan_level_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_gravity="right"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="10dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="37dp">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/white_f1"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Casual"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="normal"
                                android:textColor="@color/white_f1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(fewer alerts)"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/white_f1"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fanatic"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="normal"
                                android:textColor="@color/white_f1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(most alerts)"/>
                        </LinearLayout>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pick your fan level:"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:layout_alignParentRight="true">
                            <RadioButton
                                android:id="@+id/radio_casual"
                                android:nextFocusUp="@+id/gec_toggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="15dp"/>
                            <RadioButton
                                android:id="@+id/radio_enthuuziast"
                                android:nextFocusUp="@+id/gec_toggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="15dp"/>
                            <RadioButton
                                android:id="@+id/radio_fanatic"
                                android:nextFocusUp="@+id/gec_toggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </RadioGroup>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <include
            android:id="@+id/right_side_layout"
            layout="@layout/right_side_frame"/>
    </LinearLayout>
    <include layout="@layout/sliding_menu"/>
</android.support.v4.widget.DrawerLayout>
