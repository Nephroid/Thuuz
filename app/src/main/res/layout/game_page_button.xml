<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="204dp">
    <include
        android:id="@+id/section_header_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/game_page_section_header"/>
    <com.thuuz.roboto.RobotoTextView
        android:textSize="@dimen/tv_notice_height"
        android:textColor="@color/white_f1"
        android:id="@+id/descrip"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        custom:typeface="4"/>
    <com.thuuz.roboto.RobotoTextView
        android:textSize="@dimen/tv_fineprint_height"
        android:textColor="@color/white_f1"
        android:id="@+id/fineprint"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        custom:typeface="4"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/button_lay"
        android:background="@drawable/t_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_button_height"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp">
        <LinearLayout
            android:id="@+id/symbols"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_button_height"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/record_circle"
                android:background="@drawable/red_circle_shape"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
            <com.thuuz.gtv.view.PlayTriangleView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/play_triangle"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
        </LinearLayout>
        <com.thuuz.roboto.RobotoTextView
            android:textSize="18sp"
            android:textColor="@color/white_f1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_button_height"
            android:singleLine="false"
            android:layout_toRightOf="@+id/symbols"
            custom:typeface="4"/>
    </RelativeLayout>
    <com.thuuz.roboto.RobotoTextView
        android:gravity="right"
        android:layout_gravity="right"
        android:id="@+id/see_all_link"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        android:text="@string/see_all_broadcasts"
        custom:typeface="4"
        style="@style/LinkedText"/>
    <com.thuuz.gtv.widget.NetworkListenableImageView
        android:id="@+id/online_image_button"
        android:background="@drawable/button_dark_gray_selector"
        android:padding="5dp"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:minHeight="@dimen/tv_button_height"
        android:contentDescription="online media"/>
</LinearLayout>
