<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/edit_loc_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/name_section"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/white_f1"
                android:gravity="left"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Your TV should be showing a pairing code"
                android:singleLine="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pairing_lay"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/name_section">
            <TextView
                android:gravity="left"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type in the pairing code:"
                style="@style/text_18_f1"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/pairing_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="see your TV"
                    android:singleLine="true"
                    android:inputType="number"
                    android:imeOptions="actionDone"/>
                <Button
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/pair_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="Pair"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
