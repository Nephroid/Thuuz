<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ListItemWithHeader">
    <com.thuuz.roboto.RobotoTextView
        android:layout_gravity="center_vertical"
        android:id="@+id/separator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListSeparatorTitle"/>
    <RelativeLayout
        android:id="@+id/selectable_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/separator"
        style="@style/ListItemWithHeaderInnerSelectable">
        <ImageView
            android:id="@+id/friend_pic"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentLeft="true"
            android:contentDescription="friend picture"/>
        <ImageView
            android:id="@+id/expert_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="38dp"
            android:layout_marginTop="-12dp"
            android:src="@drawable/expert_badge"
            android:layout_below="@+id/friend_pic"
            android:layout_alignParentLeft="true"
            android:contentDescription="expert badge"/>
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_below="@+id/friend_pic"/>
        <LinearLayout
            android:id="@+id/button_or_checkmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <Button
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@+id/friend_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow"
                style="@style/text_14_normal_f1"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/checkmark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluecheck"
                android:contentDescription="checkmark or follow icon"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/right_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow"
                style="@style/text_16_bold_f1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_toLeftOf="@+id/button_or_checkmark"
            android:layout_toRightOf="@+id/friend_pic"
            android:layout_centerVertical="true">
            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/ListItemPrimeText"/>
            <TextView
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/text_14_normal_f1"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
