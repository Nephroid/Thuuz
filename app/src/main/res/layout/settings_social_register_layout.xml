<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <RelativeLayout
            android:id="@+id/left_side_layout"
            android:padding="@dimen/game_page_margin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/left_side_percent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/header_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="One more step. Just add a password to create your Thuuz account."
                        android:singleLine="false"
                        style="@style/text_16_bold_f1"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/profile_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/header_text">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/profile_pic"
                            android:background="#000000"
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:layout_marginRight="10dp"
                            android:contentDescription="profile pic"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/names_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="First name: "
                                style="@style/text_12_normal_f1"/>
                            <EditText
                                android:id="@+id/first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:inputType="textPersonName"/>
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Last name: "
                                style="@style/text_12_normal_f1"/>
                            <EditText
                                android:id="@+id/last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:inputType="textPersonName"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/credentials_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/profile_layout">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email: "
                            style="@style/text_12_normal_f1"/>
                        <EditText
                            android:id="@+id/email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textEmailAddress"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/light_gray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Password: (this becomes your Thuuz password)"/>
                        <EditText
                            android:id="@+id/pass"
                            android:nextFocusDown="@+id/mask"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textVisiblePassword"/>
                        <CheckBox
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/mask"
                            android:nextFocusDown="@+id/register_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mask password"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/register_button"
                        android:nextFocusUp="@+id/mask"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="19dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="19dp"
                        android:text="Join"
                        android:layout_below="@+id/credentials_layout"/>
                </RelativeLayout>
            </ScrollView>
        </RelativeLayout>
        <include
            android:id="@+id/right_side_layout"
            layout="@layout/right_side_frame"/>
    </LinearLayout>
    <include layout="@layout/sliding_menu"/>
</android.support.v4.widget.DrawerLayout>
