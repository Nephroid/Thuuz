<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_loc_lay"
    android:background="@color/guide_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/prompt_zip_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:id="@+id/prompt_zip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="Enter postal code to see a list of local TV providers."
            android:singleLine="false"
            style="@style/text_16_normal_f1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="(Currently, TV providers are ONLY available within the U.S.A.)"
            android:layout_below="@+id/prompt_zip_text"
            style="@style/text_12_normal_f1"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/zipcode_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <TextView
            android:id="@+id/zip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="U.S. postal (zip) code:"
            style="@style/text_16_normal_f1"/>
        <EditText
            android:textSize="18sp"
            android:textStyle="bold"
            android:id="@+id/zipcode"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="3dp"
            android:hint="Zip code"
            android:maxLength="5"
            android:inputType="number"/>
        <TextView
            android:id="@+id/city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="2dp"
            style="@style/text_16_normal_f1"/>
        <TextView
            android:id="@+id/no_zipcode"
            android:padding="20dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:text="I don&apos;t have a zipcode"
            style="@style/LinkedText"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/loading_section"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <ProgressBar
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="8dp"
            style="@android:style/Widget.ProgressBar.Small"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading_providers"
            style="@style/text_16_normal_f1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/select_provider_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp">
        <TextView
            android:gravity="left"
            android:id="@+id/tv_provider_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="5dp"
            android:text="TV provider:"
            style="@style/text_16_normal_f1"/>
        <LinearLayout
            android:id="@+id/selected_tv_provider_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Spinner
                android:id="@+id/tv_provider_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:prompt="@string/choose_your_tv_provider_title"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tv_provider_list_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.thuuz.gtv.util.ProtectedListView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_provider_list"
                android:background="@color/game_cell_bg"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:listSelector="@drawable/list_selector"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/discover_device_lay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remote Control for your TV:"
            style="@style/text_16_normal_f1"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/discover_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/connect_to_dish"
            android:singleLine="false"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/skip_discover_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="I don&apos;t have a Hopper"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/discover_progress_lay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                style="@android:style/Widget.ProgressBar.Small"/>
            <TextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/disc_device_wait_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discovering devices..."
                style="@style/text_16_normal_f1"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(This may take a minute or two)"
            style="@style/text_16_normal_f1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/remote_instructions"
        android:background="@color/dan_blue"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/guide_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="Do you have a DISH Hopper DVR?"
                style="@style/ColumnHeaderText"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:text="Thuuz can connect to your Hopper so you can change channels and start recordings right from the app."
                style="@style/text_16_normal_f1"/>
            <TextView
                android:textColor="@color/green"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:text="* On Hopper, turn on Settings/Paired Devices"
                style="@style/text_16_normal_f1"/>
            <TextView
                android:gravity="right"
                android:layout_gravity="right"
                android:id="@+id/hopper_trouble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:text="Hopper Troubleshooting..."
                style="@style/LinkedText"/>
            <TextView
                android:textColor="@color/green"
                android:id="@+id/wifi_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:text="@string/to_pair_with_hopper"
                style="@style/text_14_normal_f1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/select_device_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <TextView
            android:gravity="left"
            android:id="@+id/select_device_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="5dp"
            android:text="Select device to control:"
            style="@style/text_16_normal_f1"/>
        <Spinner
            android:id="@+id/device_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:prompt="@string/device_spinner_prompt"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/device_edit_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <TextView
            android:gravity="left"
            android:id="@+id/current_device_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="Device to control:"
            style="@style/text_16_normal_f1"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:id="@+id/current_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginBottom="5dp"
            android:text="my device"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/disconnect_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:text="Disconnect"
            style="@style/LinkedText"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/rediscover_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="5dp"
            android:text="Reconfirm"
            style="@style/LinkedText"/>
        <TextView
            android:gravity="right"
            android:layout_gravity="right"
            android:id="@+id/hopper_trouble2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="Hopper Troubleshooting..."
            style="@style/LinkedText"/>
    </LinearLayout>
</LinearLayout>
