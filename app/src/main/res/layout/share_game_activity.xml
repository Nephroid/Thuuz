<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/checkin_bg"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/share_layout"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="2dp">
            <TextView
                android:textColor="@color/white_f1"
                android:gravity="left"
                android:layout_gravity="center"
                android:id="@+id/game_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                style="@style/text_18_f1"/>
            <Button
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/share_now"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:minWidth="64dp"
                android:text="Check In"
                android:layout_weight="1"
                style="@style/BlueButton"/>
        </LinearLayout>
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="4dp"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.thuuz.gtv.view.MultilineDoneEditText
                android:textColorHint="@color/black"
                android:gravity="top"
                android:layout_gravity="center_horizontal"
                android:id="@+id/message"
                android:nextFocusUp="@+id/share_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:hint="@string/share_hint"
                android:lines="3"
                android:singleLine="false"
                android:maxLength="256"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone">
                <requestFocus/>
            </com.thuuz.gtv.view.MultilineDoneEditText>
            <ProgressBar
                android:id="@+id/progress"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:ellipsize="middle"
            android:id="@+id/url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="6dp"
            android:text=""
            android:singleLine="true"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp">
            <CheckBox
                android:id="@+id/post_to_twitter"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:button="@drawable/checkbox_tweeter"
                android:layout_centerVertical="true"/>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fake_disabled_button_text_color"
                android:id="@+id/share_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Share to other apps"
                android:drawableLeft="@drawable/share_button_icon"
                android:drawablePadding="10dp"
                android:layout_toRightOf="@+id/post_to_twitter"
                style="@style/FakeDisabledBlueButton"/>
            <Spinner
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_a_rival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <CheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/alert_my_friends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Also send\10Thuuz alert"
            android:lines="2"/>
    </LinearLayout>
</ScrollView>
