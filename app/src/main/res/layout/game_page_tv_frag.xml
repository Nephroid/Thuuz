<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/track_fragment"
    android:background="@color/game_midbar_bg"
    android:padding="10dp"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.thuuz.roboto.RobotoTextView
        android:textSize="18sp"
        android:textColor="@color/teaser_text"
        android:id="@+id/start_watching"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:singleLine="false"
        custom:typeface="4"
        style="@style/text_16_bold_f1"/>
    <com.thuuz.gtv.util.ProtectedListView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_button_list"
        android:visibility="gone"
        android:nextFocusRight="@+id/list"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:listSelector="@null"
        android:divider="@color/transparent"
        android:dividerHeight="@dimen/tv_list_divider"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/web_lay"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/dish_logo"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:src="@drawable/dish_logo"
                android:layout_alignParentRight="true"
                android:contentDescription="dish logo"/>
            <include
                android:id="@+id/header_lay"
                android:layout_toLeftOf="@+id/dish_logo"
                android:layout_centerVertical="true"
                layout="@layout/game_page_section_header"/>
        </RelativeLayout>
        <WebView
            android:id="@+id/sched"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:scrollbars="none"
            android:nextFocusUp="@+id/tv_button_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <TextView
            android:layout_gravity="right"
            android:id="@+id/web_show_all_link"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusRight="@+id/list"
            android:nextFocusUp="@+id/sched"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/see_all_broadcasts"
            style="@style/LinkedText"/>
    </LinearLayout>
    <com.thuuz.gtv.util.ProtectedListView
        android:layout_gravity="center_horizontal"
        android:id="@+id/button_list"
        android:nextFocusRight="@+id/list"
        android:nextFocusUp="@+id/tv_button_list"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@null"
        android:divider="@color/transparent"
        android:dividerHeight="@dimen/tv_list_divider"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"/>
</LinearLayout>
