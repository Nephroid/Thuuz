<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ListItemWithHeader">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/separator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListSeparator">
        <com.thuuz.roboto.RobotoTextView
            android:layout_gravity="center_vertical"
            android:id="@+id/comp_title"
            android:padding="0dp"
            android:paddingLeft="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            style="@style/ListSeparatorTitle"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/site_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.thuuz.roboto.RobotoTextView
                android:layout_gravity="center_vertical"
                android:id="@+id/site_title"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:layout_centerVertical="true"
                style="@style/ListSeparatorTitle"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/selectable_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/separator"
        style="@style/ListItemWithHeaderInnerSelectable">
        <requestFocus/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/icon_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/alert_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/bell"
                android:contentDescription="alert icon"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/icon_container"
            android:layout_centerVertical="true">
            <TextView
                android:layout_gravity="right"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/ListItemPrimeText"/>
            <TextView
                android:textColor="@color/light_gray"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/text_14_normal_f1"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
