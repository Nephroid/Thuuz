<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ListItemWithHeader">
    <com.thuuz.roboto.RobotoTextView
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListSeparatorTitle"/>
    <RelativeLayout
        android:id="@+id/selectable_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/separator"
        style="@style/ListItemWithHeaderInnerSelectable">
        <ImageView
            android:id="@+id/alert_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/bell"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="alert icon"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/icon_container"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/ListItemPrimeText"/>
            <TextView
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/text_14_normal_f1"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
