<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/webview_fragment"
    android:padding="@dimen/game_page_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white_f1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/spoilers_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Show Spoilers"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/webview_loading_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp">
        <ProgressBar
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/Widget.ProgressBar.Small"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/loading_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Loading..."
            style="@style/text_16_bold_f1"/>
    </LinearLayout>
    <WebView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/webview"
        android:background="@color/game_cell_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
