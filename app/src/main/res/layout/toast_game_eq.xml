<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/toast_bg"
    android:padding="3dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/thuuz_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:src="@drawable/logo"
        android:minWidth="85dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:contentDescription="logo"/>
    <View
        android:id="@+id/rt_margin"
        android:layout_width="12dp"
        android:layout_height="35dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <com.thuuz.gtv.view.GecCircleView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/game_gec"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginLeft="6dp"
        android:minWidth="35dp"
        android:layout_toLeftOf="@+id/rt_margin"
        android:layout_centerVertical="true"
        custom:typeface="6"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#f1f1f1"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:singleLine="false"
        android:layout_toLeftOf="@+id/game_gec"
        android:layout_toRightOf="@+id/thuuz_logo"
        android:layout_centerVertical="true"/>
</RelativeLayout>
